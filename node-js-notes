// comparison operators

// equal to (command) = $eq
// not equal to (command) = $ne
// greater than (command) = $gt
// greater than equal to (command) = $gte
// less than (command) = $lt
// less than equal to (command) = $lte
// in operator means only show selected values (command) = $in
// not in operator means except selected values show remaining values (command) = $nin

example: db.products.find({'price':{$eq: 699}});
example: db.products.find({'price':{$in: [699,599,899]}});

// want to cound how many same values in documents: example: 
db.products.find({ 'price': { $eq: 699 } }).count()


// cursor methods
count(), limit(), skip(), sort()

// total count of documents in db collection
db.products.find({ 'price': { $gt: 250 } }).count();
// show only selected 5 documents
db.products.find({ 'price': { $gt: 250 } }).limit(5);
// show only selected 5 documents and skip from first to second doc
db.products.find({ 'price': { $gt: 250 } }).limit(5).skip(2);
// (1) for ascending and (-1) for descending
db.products.find({ 'price': { $gt: 250 } }).limit(3).sort({ 'price': 1 });

// logical operator

$and, $or, $not, $nor

// $and if both coniditions are true we will get doc that contains these data in it.
db.products.find({ $and: [{ 'price': { $gt: 2000 } }, { 'name': 'ring' }] })
// $or if 1st conidition is true show the doc or if 2nd condition is true the show doc also
db.products.find({ $or: [{ 'price': { $gt: 2000 } }, { 'name': 'ring' }] })
// $nor except these 2 docs data show the remaining docs
db.products.find({ $nor: [{ 'price': { $gt: 2000 } }, { 'name': 'ring' }] })
// price is not equal to or greater than 2000
db.products.find({ 'price': { $not: { $eq: 2000 } } }).count()

db.products.find({ $or: [{ 'price': { $lt: 50 } }, { 'name': 'Kids Educational Toys' }] });

// expression operator

// we can multiply subtract divide and using expression operator
db.sales.find({ $expr: { $gt: [{ $multiply: ["$quantity", "$price"] }, "$targetPrice"], }, });

// elements operator
$exists, $type, $size,
    
// if we want to check the key value of an obj or doc is available or not we need this (command):
db.products.find({'price':{$exists: true},'price':{$lt:500}}).count()

// if we want to find the size of an array how many objects or doc in this array we need this (command):
db.comments.find({ 'comments': { $size: 4 } })
// or if we want to find comments and dont want to show the remaining data in doc we need to use projection method 1 means is show the selected field and 0 means not show the selected field.
db.comments.find({ 'comments': { $size: 2 } }, { comments: 1, _id: 0 })
db.comments.find({ 'comments': { $size: 2 } }, { comments: 0, title: 0, _id: 0 })

// (embeded document) if you want to show array obj in array obj 
db.comments.find({ 'comments.user': 'lily' })

// if you want to check data types of the document we need to use (command):
db.products.find({'price':{$type:'number'}}).count()
