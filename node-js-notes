// update single and multiple

db.sales.updateOne({ _id: 3 }, { $set: { 'price': 55 } })
db.products.updateOne({ 'name': 'Car Jump Starter' }, { $set: { 'price': 55 } })

db.products.updateMany({ 'name': 'Car Jump Starter' }, { $set: { 'price': 55 } })
// update in pure array values
db.products.updateMany({'name':'Modern Sofa Set'},{$set: {'colors.0':'#000'}})
// update in pure array values
db.products.updateMany({ 'name': 'Car Jump Starter' }, { $set: { 'colors': ['#111111', '#111111', '#111111'] } })

db.products.updateMany({ $and: [{ '_id': ObjectId("64c23f13f8ffc4957dc4f308") }, { 'price': 55 }] }, { $set: { 'colors': ['#333', '#333333', '#000'] } })

db.products.updateMany({ $and: [{ '_id': ObjectId("64c23f13f8ffc4957dc4f308") }, { 'price': 55 }] }, { $set: { 'colors': ['#333', '#777', '#000'] } })

db.products.updateMany({ 'colors': { $eq: '#111111' } }, { $set: { 'colors.$': '#999999' } })

db.laptops.updateMany({ 'price': { $ne: 200 } }, { $set: { 'price.$[]': 100 } })

// removing and renaming the fields
// if we want to change the key name of the document we need to use this (command) $rename:
db.products.updateMany({ 'price': 55 }, { $rename: { 'isFeatured': 'isFeature' } })
// if we want to delete the key name of the document we need to use this (command) $unset:
db.products.updateMany({ 'price': 55 }, { $unset: { 'isFeatured': 'isFeature' } })

// updating array and embedded documents
$push, $pop, $set, $unset

// add new field (key) in obj
db.sales.updateOne({ '_id': 3 }, { $set: { 'oldPrice': 30 } })
// delete field (key) in obj
db.sales.updateOne({ '_id': 3 }, { $unset: { 'oldPrice': 1 } })
db.comments.updatedOne({'_id':6},{$unset:{'metadata':1}})
// want to add data in array obj
db.comments.updateOne({ '_id': 5 }, { $push: { comments: { user: 'zain', text: 'now its good' } } })
// want to delete data at the last from an array obj
db.comments.updateOne({ '_id': 5 }, { $pop: { comments: 1 } })
// wan to change the key value of an array object by using positional ($) operator use this (command)
db.comments.updateOne({ 'comments.user': 'Jack' }, { $set: { 'comments.$.text': 'text change hogaya' } })

// delete whole document from collection
deleteOne(), deleteMany()
// delete one document from collection
db.comments.deleteOne({ 'price': 55 })
// delete all document from collection on behalf of price
db.comments.deleteMany({ 'price': 55 })


// projection
// to show any one field that will select by 1
db.comments.find({'comments':{$size:2}},{comments:1})

// if dont want to show id just give value to the key 0 and it will not show:(exception only for id)
db.comments.find({'comments':{$size:2}},{comments:1,_id:0})


// agreegation

// $match method to add multiple conditions
db.products.aggregate([{ $match: { 'name': 'Gorgeous Rubber Chair' } }])
db.comments.aggregate([{$match:{$and:[{ 'metadata.views': {$gte:800,$lte:1000}},{ 'metadata.likes': {$gte:50}}]}}])
db.comments.aggregate([{ $match: { $and: [{ 'metadata.views': { $gt: 800, $lt: 1000 } }, { 'metadata.likes': { $gt: 50 } }] } },])

// $group method
// how many same items are exists we need must _id and calc how many same items is there use {$sum:1}
db.products.aggregate([{ $group: { _id: '$name', total: { $sum: 1 } } }])
// if you want to sum any other key value like price items etc we need to change just this.
db.products.aggregate([{ $group: { _id: '$name', total: { $sum: '$price' } } }])
// find average
db.products.aggregate([{ $match: { 'name': 'Building Blocks Set' } }, { $group: { _id: '$name', total: { $sum: '$price' }, average: { $avg: '$price' } } }, { $sort: { total: -1 } }])
// sort by descending order using $sort -1
db.products.aggregate([{ $match: { 'price': { $gt: 1200 } } }, { $group: { _id: '$name', total: { $sum: '$price' }, average: { $avg: '$price' } } }, { $sort: { total: -1 } }])

// project method to filter more data and add multiple fields
db.products.aggregate([{ $match: { 'price': { $gt: 1200 } } }, { $project: { price: 1, _id: 0, discountPrice: { $multiply: ['$price', 0.5] } } }])

// unwind method use to deconstruct or destructure the array data.
db.products.aggregate([{ $unwind: '$colors' }, { $match: { 'price': { $gt: 1200 } } }, { $group: { _id: '$price', allColors: { $push: '$colors' } } }])
// use addtoset method instead of push (stage) to remove duplicate data from array at that time you add data in array.
db.products.aggregate([{ $unwind: '$colors' }, { $match: { 'price': { $gt: 1200 } } }, { $group: { _id: '$price', allColors: { $addToSet: '$colors' } } }])

db.products.find({ 'price': { $eq: 49 } }, { price: 1, colors: 1, _id: 0 })

db.products.aggregate([{ $unwind: '$colors' },{$match:{'price':{$eq:49}}}, { $group: { _id: '$price', allColors: { $addToSet: '$colors' } } }])




