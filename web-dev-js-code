     let portfolio_lists = gsap.utils.toArray(".review_list .review_box")
     portfolio_lists.forEach((portfolio, i) => {
         gsap.set(portfolio, {
             opacity: 0.7,
             rotateX: 90,
             scale: 0.5
         })
         let t1 = gsap.timeline()

         t1.set(portfolio, {
             position: "relative",
         })
         t1.to(portfolio, {
             scrollTrigger: {
                 trigger: portfolio,
                 scrub: 2,
                 duration: 1.5,
                 start: "top 90%",
                 end: "+=50",
                 scale: 0,
             },
             scale: 1,
             opacity: 1,
             rotateX: 0,
         })
     });



/******************************* navlink active ******************************/
$(document).ready(function(){
var url = window.location.pathname;
var filename = url.substring(url.lastIndexOf('/')+1);
$(".nav-link.custom_navlink").removeClass("active");
$(`.nav-link.custom_navlink[href="${filename}"]`).addClass("active")
})

.on('initialized.owl.carousel changed.owl.carousel', function(e) {
    var carousel = e.relatedTarget;
    $('#slider-counter').text(carousel.relative(carousel.current()) + 1 + '/' + carousel.items().length);
})


/******************************* sticky scroll ******************************/
  $(window).scroll(function() {    
    var scroll = $(window).scrollTop();
    // console.log(scroll);
    if (scroll >= 5300 && scroll <= 9400) {
       $(".program-steps-sticky").addClass("stuck");
    }else{
        $(".program-steps-sticky").removeClass("stuck");
    }
}); 